#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
set -euo pipefail

make=$1
validations=$2
output=$3
shift 3

workdir=$(mktemp -d ./policy.XXXXXX)
trap 'rm -rf "$workdir"' EXIT
cp "$@" "$workdir/"
if "$validations"; then
    sed -i /user_namespace/d "$workdir/qm.if"
fi
"$make" -C "$workdir" -f /usr/share/selinux/devel/Makefile qm.pp
bzip2 -c -9 "$workdir/qm.pp" > "$output"
