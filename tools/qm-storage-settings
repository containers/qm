# Global vars
TMP_QM_IMG_DIR="tmp.images"
STORAGE_CONFIG=""

# exec_command will try to find the command before execute, it will try first in a regular
# path (normal distros) and if not unable to find, it look for the command using ostree path
# structure
exec_command() {
    COMMAND=$1
    if [ ! -f "$1" ]; then # no path, let's try ostree approach
        COMMAND="/run/osbuild/tree$1"
        if [ -f "${COMMAND}" ]; then
	    # FIXME: support this in qm-rootfs and remove this if condition
	    # it's a deploy/install moment in ostree
  	    echo "/run/osbuild/tree/usr/lib/qm/rootfs"
	    return
        else
            echo "Exiting unable to find QM ROOTFS ${COMMAND}"
            exit 255
	fi
    fi

    # print and  output of QM ROOTFS
    "$COMMAND"
}

setup_init() {
    ROOTFS=$(exec_command "/usr/share/qm/qm-rootfs")

    # Always configure the writable /etc copy. On CS9 it is already present;
    # on CS10, seed it from the vendor default instead of editing /usr/share.
    STORAGE_CONFIG="${ROOTFS}/etc/containers/storage.conf"
    if [ -f "${STORAGE_CONFIG}" ]; then
        return
    fi

    for DEFAULT_STORAGE_CONFIG in \
        "${ROOTFS}/usr/share/containers/storage.conf" \
        "${ROOTFS}/usr/lib/containers/storage.conf"; do
        if [ -f "${DEFAULT_STORAGE_CONFIG}" ]; then
            install -D -m 0644 "${DEFAULT_STORAGE_CONFIG}" "${STORAGE_CONFIG}"
            return
        fi
    done

    echo "Exiting: no storage.conf found under ${ROOTFS}" >&2
    exit 255
}

additional_images_storages() {
    if grep -Fq '"/var/lib/shared"' "${STORAGE_CONFIG}"; then
        return
    fi

    local tmp="${STORAGE_CONFIG}.tmp"
    if ! awk '
        function emit_array( i) {
            if (last_item && body[last_item] !~ /,[[:space:]]*(#.*)?$/) {
                if (body[last_item] ~ /[[:space:]]+#/) {
                    sub(/[[:space:]]+#/, ", #", body[last_item])
                } else {
                    body[last_item] = body[last_item] ","
                }
            }
            for (i = 1; i <= count; i++) {
                print body[i]
                delete body[i]
            }
            print "    \"/var/lib/shared\","
            print close_line
            count = 0
            last_item = 0
        }

        !added && !in_array {
            line = $0
            match(line, /^[[:space:]]*/)
            indent = substr(line, 1, RLENGTH)
            content = substr(line, RLENGTH + 1)
            commented_array = 0

            if (content ~ /^#[[:space:]]*additionalimagestores[[:space:]]*=/) {
                sub(/^#[[:space:]]*/, "", content)
                commented_array = 1
            } else if (content !~ /^additionalimagestores[[:space:]]*=/) {
                print
                next
            }

            open_idx = index(content, "[")
            if (!open_idx) {
                print
                next
            }
            print indent substr(content, 1, open_idx)
            rest = substr(content, open_idx + 1)
            if (rest ~ /\]/) {
                close_idx = index(rest, "]")
                value = substr(rest, 1, close_idx - 1)
                suffix = substr(rest, close_idx + 1)
                if (value ~ /[^[:space:]]/) {
                    body[++count] = "    " value
                    if (value ~ /"[^"]+"/) {
                        last_item = count
                    }
                }
                close_line = "]" suffix
                emit_array()
                added = 1
            } else {
                if (rest ~ /[^[:space:]]/) {
                    body[++count] = "    " rest
                    if (rest ~ /"[^"]+"/) {
                        last_item = count
                    }
                }
                in_array = 1
            }
            next
        }

        in_array {
            line = $0
            if (commented_array) {
                match(line, /^[[:space:]]*/)
                indent = substr(line, 1, RLENGTH)
                content = substr(line, RLENGTH + 1)
                if (content ~ /^#[[:space:]]*"[^"]*"[[:space:]]*,?[[:space:]]*(#.*)?$/ ||
                    content ~ /^#[[:space:]]*\][[:space:]]*(#.*)?$/) {
                    sub(/^#[[:space:]]*/, "", content)
                    line = indent content
                }
            }

            if (line ~ /^[[:space:]]*\]/) {
                close_line = line
                emit_array()
                in_array = 0
                added = 1
                next
            }

            body[++count] = line
            if (line !~ /^[[:space:]]*#/ && line ~ /"[^"]+"/) {
                last_item = count
            }
            next
        }

        { print }
        END { if (!added) exit 1 }
    ' "${STORAGE_CONFIG}" > "${tmp}"; then
        rm -f "${tmp}"
        echo "Exiting: additionalimagestores array not found in ${STORAGE_CONFIG}" >&2
        return 1
    fi

    mv "${tmp}" "${STORAGE_CONFIG}"
}

update_storage_conf() {

    if [ ! -f "${STORAGE_CONFIG}" ]; then
        echo "Exiting... unable to find ${STORAGE_CONFIG}"
	exit 255
    fi

    # Add /var/lib/shared to the additional image store array.
    mkdir -p "${ROOTFS}/var/lib/shared"
    additional_images_storages

    # Uncomment or change 'transient_store'
    if grep -Eq '^[[:space:]]*#?[[:space:]]*transient_store[[:space:]]*=' "$STORAGE_CONFIG"; then
        sed -i -E \
            's/^[[:space:]]*#?[[:space:]]*transient_store[[:space:]]*=.*/transient_store = true/' \
            "$STORAGE_CONFIG"
    fi

    # Append TMPDIR
    if test -f "${ROOTFS}/etc/containers/containers.conf"; then
        if ! grep -q "TMPDIR=/var/${TMP_QM_IMG_DIR}" "${ROOTFS}/etc/containers/containers.conf"; then
            mkdir -p "${ROOTFS}/var/${TMP_QM_IMG_DIR}"
            cat >> "${ROOTFS}/etc/containers/containers.conf" <<EOF

[engine]
env = ["TMPDIR=/var/${TMP_QM_IMG_DIR}"]
EOF
        fi
    fi
}

# main
setup_init
update_storage_conf
exit 0
